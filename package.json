{
  "name": "bullpen",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Minimal coding-agent harness modeled on T3 Code's architecture",
  "scripts": {
    "server": "node src/server.ts",
    "client": "node src/client.ts",
    "typecheck": "tsc --noEmit",
    "start": "node src/cli.ts start",
    "stop": "node src/cli.ts stop",
    "open": "node src/cli.ts open",
    "install-app": "node src/cli.ts install"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@fontsource-variable/inter": "^5.1.1",
    "@types/qrcode": "^1.5.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.55.0",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "bin": {
    "bullpen": "bin/bullpen"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
